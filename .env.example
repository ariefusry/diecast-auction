POSTGRES_USER=diecast
# Required by docker compose, no default. Hex only, since it goes inside DATABASE_URL.
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=diecast

# For running the API on the host (go run). Same password as POSTGRES_PASSWORD.
DATABASE_URL=postgres://diecast:<POSTGRES_PASSWORD>@localhost:5432/diecast?sslmode=disable
PORT=8080
# At least 32 bytes. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes

# Optional. Without a key, POST /auctions/search/ai falls back to keyword search.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Comma separated browser origins allowed by CORS (default: the Vite dev server).
CORS_ORIGINS=http://localhost:5173

# Item photos (mount a volume here in production).
UPLOAD_DIR=uploads

# Read the client IP from X-Real-IP. Only behind a reverse proxy that sets it
# (docker-compose sets this for the api service); never on a directly exposed API.
TRUST_PROXY=false

# docker compose up: host port of the web container, and the public origin for CORS.
WEB_PORT=8081
PUBLIC_ORIGIN=http://localhost:8081

# docker compose --profile https: the public domain Caddy gets a certificate for
# (its DNS must point at this host). Then also set WEB_PORT=127.0.0.1:8081.
DOMAIN=localhost

# Password of the demo accounts the seeder creates (docker compose --profile demo).
# Empty means the public "demo-password". On a public server set a secret
# (openssl rand -hex 24) so the demo catalog shows but nobody can sign in as demo users.
DEMO_PASSWORD=
